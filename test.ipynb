    "import numpy as np\n",
    "import numba\n",
    "import time\n",
    "\n",
    "@numba.jit\n",
    "def jit_array_manip(a, b):\n",
    "    return a + b\n",
    "\n",
    "def array_manip(a, b):\n",
    "    return a + b\n",
    "\n",
    "a = np.array([1, 2, 3])\n",
    "b = np.array([4, 5, 6])\n",
    "\n",
    "jit_array_manip(a, b)\n",
    "\n",
    "t_s = time.time()\n",
    "jit_array_manip(a, b)\n",
    "print(time.time() - t_s)"
   ]
  }
